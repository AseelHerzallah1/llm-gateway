# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Database
# Local dev (uvicorn on your machine — PostgreSQL exposed on localhost):
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/llm_gateway

# Docker Compose (app container uses service name "db" as hostname):
# DATABASE_URL=postgresql+asyncpg://gateway:gateway@db:5432/llm_gateway

# OpenAI provider (Phase 3+)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Provider timeouts (Phase 4.6) — seconds
OPENAI_CONNECT_TIMEOUT_S=10
OPENAI_READ_TIMEOUT_S=60
OPENAI_STREAM_IDLE_TIMEOUT_S=30
OPENAI_WRITE_TIMEOUT_S=10
OPENAI_POOL_TIMEOUT_S=10

# Embeddings (Phase 6+)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic provider (Phase 7+)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_DEFAULT_MAX_TOKENS=1024
ANTHROPIC_CONNECT_TIMEOUT_S=10
ANTHROPIC_READ_TIMEOUT_S=60
ANTHROPIC_STREAM_IDLE_TIMEOUT_S=30
ANTHROPIC_WRITE_TIMEOUT_S=10
ANTHROPIC_POOL_TIMEOUT_S=10

# Groq provider (Phase 7+) — OpenAI-compatible API
GROQ_API_KEY=gsk-your-groq-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CONNECT_TIMEOUT_S=10
GROQ_READ_TIMEOUT_S=60
GROQ_STREAM_IDLE_TIMEOUT_S=30
GROQ_WRITE_TIMEOUT_S=10
GROQ_POOL_TIMEOUT_S=10

# Security (Phase 2.3+)
SECRET_KEY=change-me-to-a-long-random-string

# Semantic cache (Phase 6+)
CACHE_SIMILARITY_THRESHOLD=0.92

# Local dev — optional test gateway key (from seed_test_project.py)
# GATEWAY_TEST_API_KEY=gw-sk-your-key-here
