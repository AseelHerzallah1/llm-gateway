      "targets": [
        {
          "expr": "100 * sum(increase(llmgateway_requests_total{cache_result=~\"exact_hit|semantic_hit\",status=\"success\",stream=\"false\"}[$__range])) / clamp_min(sum(increase(llmgateway_requests_total{cache_result=~\"exact_hit|semantic_hit\",status=\"success\",stream=\"false\"}[$__range])) + sum(increase(llmgateway_requests_total{cache_result=\"miss\",status=\"success\",stream=\"false\"}[$__range])), 1)",
